new file mode 100644
index 0000000000000000000000000000000000000000..1b7f9b4072410b1153c0cfae50126cf7bcd3859f
--- /dev/null
+++ b/crates/bowl/src/world/cow.rs
@@ -0,0 +1,107 @@
+//! Transparent payload instrumentation: Arc keeps exactly its existing COW policy.
+use super::*;
+use crate::metrics::{self, CowKind};
+use std::time::Instant;
+
+#[repr(transparent)]
+pub(crate) struct CowData<T>(pub T);
+
+impl<T: Default> Default for CowData<T> {
+    fn default() -> Self { Self(T::default()) }
+}
+
+impl<T> Deref for CowData<T> {
+    type Target = T;
+    fn deref(&self) -> &T { &self.0 }
+}
+
+impl<T> DerefMut for CowData<T> {
+    fn deref_mut(&mut self) -> &mut T { &mut self.0 }
+}
+
+pub(crate) trait CowPayload: Clone {
+    const KIND: CowKind;
+    /// Logical elements and inline bytes; excludes allocator/node overhead.
+    fn copy_size(&self) -> (u64, u64);
+}
+
+impl<T: CowPayload> Clone for CowData<T> {
+    fn clone(&self) -> Self {
+        if !metrics::enabled() { return Self(self.0.clone()); }
+        let (units, bytes) = self.0.copy_size();
+        let start = Instant::now();
+        let data = self.0.clone();
+        let nanos = start.elapsed().as_nanos() as u64;
+        metrics::record_cow(T::KIND, units, bytes, nanos);
+        Self(data)
+    }
+}
+
+impl<T> CowPayload for BTreeMap<Entity, ComponentEntry<T>> {
+    const KIND: CowKind = CowKind::Entries;
+    fn copy_size(&self) -> (u64, u64) {
+        let entries = self.len() as u64;
+        (entries, entries * (size_of::<Entity>() + size_of::<ComponentEntry<T>>()) as u64)
+    }
+}
+
+impl CowPayload for HashMap<u64, BTreeSet<Entity>> {
+    const KIND: CowKind = CowKind::Fingerprints;
+    fn copy_size(&self) -> (u64, u64) {
+        let members = self.values().map(|bucket| bucket.len() as u64).sum::<u64>();
+        let bytes = members * size_of::<Entity>() as u64
+            + self.len() as u64 * (size_of::<u64>() + size_of::<BTreeSet<Entity>>()) as u64;
+        (members, bytes)
+    }
+}
+
+impl CowPayload for Vec<u64> {
+    const KIND: CowKind = CowKind::Presence;
+    fn copy_size(&self) -> (u64, u64) {
+        (self.len() as u64, (self.len() * size_of::<u64>()) as u64)
+    }
+}
+
+impl CowPayload for Vec<(TypeId, Entity)> {
+    const KIND: CowKind = CowKind::PlanLog;
+    fn copy_size(&self) -> (u64, u64) {
+        (self.len() as u64, (self.len() * size_of::<(TypeId, Entity)>()) as u64)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    struct Payload { copies: Arc<AtomicU64>, value: u64 }
+    impl Clone for Payload {
+        fn clone(&self) -> Self {
+            self.copies.fetch_add(1, Ordering::Relaxed);
+            Self { copies: self.copies.clone(), value: self.value }
+        }
+    }
+    impl CowPayload for Payload {
+        const KIND: CowKind = CowKind::Entries;
+        fn copy_size(&self) -> (u64, u64) { (1, size_of::<Self>() as u64) }
+    }
+
+    #[test]
+    fn transparent_wrapper_copies_payload_only_when_a_snapshot_still_shares_it() {
+        let copies = Arc::new(AtomicU64::new(0));
+        let mut live = Arc::new(CowData(Payload { copies: copies.clone(), value: 1 }));
+        Arc::make_mut(&mut live).value = 2;
+        assert_eq!(copies.load(Ordering::Relaxed), 0);
+        let snapshot = live.clone();
+        Arc::make_mut(&mut live).value = 3;
+        assert_eq!(copies.load(Ordering::Relaxed), 1);
+        assert_eq!(snapshot.value, 2);
+        assert_eq!(live.value, 3);
+        Arc::make_mut(&mut live).value = 4;
+        assert_eq!(copies.load(Ordering::Relaxed), 1);
+        drop(snapshot);
+        let weak = Arc::downgrade(&live);
+        Arc::make_mut(&mut live).value = 5;
+        assert!(weak.upgrade().is_none());
+        assert_eq!(copies.load(Ordering::Relaxed), 1, "weak disassociation is not a payload copy");
+    }
+}
