+// commit_system_run holds state and does not await inside this scope. The
+// marker is thread-local so unrelated worker work cannot acquire attribution.
+thread_local! {
+    static IN_PUBLICATION: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+pub(crate) struct PublicationScope(Option<bool>);
+
+impl PublicationScope {
+    pub(crate) fn enter() -> Self {
+        Self(enabled().then(|| IN_PUBLICATION.replace(true)))
+    }
+}
+
+impl Drop for PublicationScope {
+    fn drop(&mut self) {
+        if let Some(previous) = self.0 { IN_PUBLICATION.set(previous); }
+    }
+}
+
+#[derive(Clone, Copy)]
+pub(crate) enum CowKind { Entries, Fingerprints, Presence, PlanLog }
+
+/// Called by actual payload Clone implementations, never by a refcount guess.
+/// Byte counts describe logical inline storage, not allocated/physical traffic.
+pub(crate) fn record_cow(kind: CowKind, units: u64, shallow_bytes: u64, nanos: u64) {
+    use Counter::*;
+    let counters = match kind {
+        CowKind::Entries => [CowEntriesClones, CowEntriesUnits, CowEntriesShallowBytes, CowEntriesNs, CowEntriesPublicationClones, CowEntriesPublicationUnits, CowEntriesPublicationShallowBytes, CowEntriesPublicationNs],
+        CowKind::Fingerprints => [CowFingerprintsClones, CowFingerprintsUnits, CowFingerprintsShallowBytes, CowFingerprintsNs, CowFingerprintsPublicationClones, CowFingerprintsPublicationUnits, CowFingerprintsPublicationShallowBytes, CowFingerprintsPublicationNs],
+        CowKind::Presence => [CowPresenceClones, CowPresenceUnits, CowPresenceShallowBytes, CowPresenceNs, CowPresencePublicationClones, CowPresencePublicationUnits, CowPresencePublicationShallowBytes, CowPresencePublicationNs],
+        CowKind::PlanLog => [CowPlanLogClones, CowPlanLogUnits, CowPlanLogShallowBytes, CowPlanLogNs, CowPlanLogPublicationClones, CowPlanLogPublicationUnits, CowPlanLogPublicationShallowBytes, CowPlanLogPublicationNs],
+    };
+    for (counter, value) in counters[..4].iter().copied().zip([1, units, shallow_bytes, nanos]) {
+        add(counter, value);
+    }
+    if IN_PUBLICATION.get() {
+        for (counter, value) in counters[4..].iter().copied().zip([1, units, shallow_bytes, nanos]) {
+            add(counter, value);
+        }
+    }
+}
