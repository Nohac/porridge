+use super::*;
+use crate::{Component, MutRef, Where, Eq as KeyEq, Without};
+use std::{fmt::Debug, sync::{Mutex, Condvar, mpsc, atomic::{AtomicBool, Ordering}}, time::Duration};
+
+struct A;
+struct B;
+struct Flag;
+impl Component for A {}
+impl Component for B {}
+impl Component for Flag {}
+
+#[derive(Hash)]
+struct Group(u64);
+impl Component for Group { fn fingerprint(&self) -> Option<u64> { Some(crate::hash_component(self)) } }
+
+fn runtime() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_multi_thread().worker_threads(2).build().unwrap()
+}
+
+async fn compare<P: SystemParam + 'static>(snapshot: Arc<Snapshot>, hint: Option<&[Entity]>)
+where P::State: Debug + PartialEq,
+{
+    let id = SystemId(0);
+    let prepared = P::prepare(&snapshot);
+    let first = plan_prepared_with_scratch::<P>(id, &snapshot, &HashMap::new(), hint, &prepared, &mut Scratch::default());
+    let memo = Arc::new(first.invocations.iter().step_by(2).map(|invocation| (
+        invocation.owner.clone(), MemoEntry { deps: invocation.deps.clone(), planned_revision: snapshot.revision_raw(), settle_epoch: 0 }
+    )).collect());
+    let expected = plan_prepared_with_scratch::<P>(id, &snapshot, &memo, hint, &prepared, &mut Scratch::default());
+    let mut buffers = PlanningStorage::default();
+    for _ in 0..2 {
+        let (_, actual) = prepare::<P, _>(id, Arc::clone(&snapshot), Arc::clone(&memo), hint, P::prepare(&snapshot), &mut buffers, 2).await;
+        assert_eq!(actual.completed, expected.completed);
+        assert_eq!(actual.invocations.len(), expected.invocations.len());
+        for (a, b) in actual.invocations.iter().zip(&expected.invocations) {
+            assert_eq!(a.owner, b.owner);
+            assert_eq!(a.state, b.state);
+            assert_eq!(a.deps, b.deps);
+            assert_eq!(a.access, b.access);
+        }
+        assert_eq!(Arc::strong_count(&memo), 1, "normal planning releases all memo readers");
+        assert!(!buffers.workers.is_empty(), "exercise worker preparation");
+        assert!(buffers.workers.len() <= 2);
+    }
+}
+
+#[test]
+fn chunks_match_serial_metadata_for_optional_filters_joins_and_dirty_hints() {
+    runtime().block_on(async {
+        let mut world = Snapshot::new();
+        world.init_presence(vec![TypeId::of::<A>(), TypeId::of::<B>(), TypeId::of::<Flag>(), TypeId::of::<Group>()]);
+        for raw in 0..32 {
+            let entity = Entity::from_raw(raw);
+            world.insert_base(entity, A);
+            world.insert_base(entity, Group(raw % 8));
+            if raw % 3 == 0 { world.insert_base(entity, B); }
+            if raw % 5 == 0 { world.insert_base(entity, Flag); }
+        }
+        let snapshot = Arc::new(world);
+        type Optional = Query<(Entity, &'static A, Option<&'static B>), Without<Flag>>;
+        compare::<Optional>(Arc::clone(&snapshot), None).await;
+        let hint: Vec<_> = (0..16).map(Entity::from_raw).collect();
+        compare::<Optional>(Arc::clone(&snapshot), Some(&hint)).await;
+        type Joined = (Query<(Entity, &'static A, &'static Group)>, Query<(Entity, &'static B), Where<KeyEq<Group>>>);
+        compare::<Joined>(snapshot, None).await;
+    });
+}
+
+struct LocalMetadata;
+impl SystemParam for LocalMetadata {
+    type State = (Entity, std::thread::ThreadId);
+    type Item<'a> = ();
+    fn states(_: &Snapshot) -> Vec<Self::State> {
+        (0..16).map(|id| (Entity::from_raw(id), std::thread::current().id())).collect()
+    }
+    fn keys(state: &Self::State) -> Vec<Entity> {
+        assert_eq!(state.1, std::thread::current().id());
+        vec![state.0]
+    }
+    fn deps(_: &Snapshot, _: &Self::State) -> Vec<Dep> { vec![] }
+    fn access(_: &Snapshot, _: &Self::State) -> Vec<Access> { vec![] }
+    fn fetch(_: &Bowl, _: &Snapshot, _: &Self::State, _: &Commands<Anything>, _: &mut GuardStore) {}
+}
+
+#[test]
+fn custom_metadata_keeps_serial_thread_affinity_by_default() {
+    runtime().block_on(async {
+        let snapshot = Arc::new(Snapshot::new());
+        let mut buffers = PlanningStorage::default();
+        let (_, plan) = prepare::<LocalMetadata, _>(SystemId(0), Arc::clone(&snapshot), Arc::new(HashMap::new()), None,
+            LocalMetadata::prepare(&snapshot), &mut buffers, 1).await;
+        assert_eq!(plan.invocations.len(), 16);
+        assert!(buffers.workers.is_empty());
+    });
+}
+
+struct Gate {
+    blocked: Mutex<bool>,
+    wake: Condvar,
+    entered: mpsc::Sender<()>,
+    panic_once: AtomicBool,
+}
+
+impl Gate {
+    fn enter(&self) {
+        if self.panic_once.swap(false, Ordering::SeqCst) { panic!("planned test panic"); }
+        let mut blocked = self.blocked.lock().unwrap();
+        if *blocked { self.entered.send(()).unwrap(); }
+        while *blocked { blocked = self.wake.wait(blocked).unwrap(); }
+    }
+
+    fn release(&self) {
+        *self.blocked.lock().unwrap() = false;
+        self.wake.notify_all();
+    }
+}
+
+struct ReleaseOnDrop(Arc<Gate>);
+impl Drop for ReleaseOnDrop { fn drop(&mut self) { self.0.release(); } }
+
+struct Request { gate: Arc<Gate>, value: u64 }
+struct Answer(u64);
+struct Counter(u64);
+impl Component for Request {}
+impl Component for Answer {}
+impl Component for Counter {}
+
+#[derive(Clone)]
+struct GatedState { entity: Entity, gate: Arc<Gate> }
+struct Gated { entity: Entity, value: u64 }
+
+impl SystemParam for Gated {
+    fn parallel_planning() -> bool { true }
+    type State = GatedState;
+    type Item<'a> = Self;
+    fn states(snapshot: &Snapshot) -> Vec<GatedState> {
+        snapshot.entities_with::<Request>().into_iter().map(|entity| GatedState {
+            entity, gate: Arc::clone(&snapshot.get::<Request>(entity).unwrap().gate),
+        }).collect()
+    }
+    fn keys(state: &GatedState) -> Vec<Entity> { state.gate.enter(); vec![state.entity] }
+    fn deps(snapshot: &Snapshot, state: &GatedState) -> Vec<Dep> {
+        vec![snapshot.resolve_store::<Request>().dependency(state.entity, false).unwrap()]
+    }
+    fn access(_: &Snapshot, state: &GatedState) -> Vec<Access> { vec![Access::read::<Request>(state.entity)] }
+    fn fetch(_: &Bowl, snapshot: &Snapshot, state: &GatedState, _: &Commands<Anything>, _: &mut GuardStore) -> Self {
+        Self { entity: state.entity, value: snapshot.get::<Request>(state.entity).unwrap().value }
+    }
+    fn interest_types() -> Option<Vec<TypeId>> { Some(vec![TypeId::of::<Request>()]) }
+}
+
+fn answer(request: Gated, mut commands: Commands<Anything>) {
+    commands.entity(request.entity).insert(Answer(request.value));
+}
+
+fn increment(counter: Query<(Entity, MutRef<'_, Counter>)>) { let (_, mut counter) = counter.item(); counter.0 += 1; }
+
+#[test]
+fn driver_cancellation_and_worker_panic_restore_memo_while_readers_are_alive() {
+    runtime().block_on(async {
+        let (entered, receiver) = mpsc::channel();
+        let gate = Arc::new(Gate { blocked: Mutex::new(false), wake: Condvar::new(), entered, panic_once: AtomicBool::new(false) });
+        let _release = ReleaseOnDrop(Arc::clone(&gate));
+        let bowl = Bowl::builder().system(increment).system(answer).build();
+        bowl.insert((Counter(0),)).await;
+        let mut entities = Vec::new();
+        for _ in 0..4 { entities.push(bowl.insert((Request { gate: Arc::clone(&gate), value: 1 },)).await.entity()); }
+        bowl.stir().await;
+        assert_eq!(bowl.scoop::<Query<&Counter>>().await.collect()[0].0, 1);
+        bowl.set_planning_chunk_size(1);
+        for &entity in &entities { bowl.entity(entity).insert((Request { gate: Arc::clone(&gate), value: 2 },)).await; }
+        *gate.blocked.lock().unwrap() = true;
+        let mut driver = Box::pin(bowl.stir());
+        assert!(futures::poll!(&mut driver).is_pending());
+        receiver.recv_timeout(Duration::from_secs(5)).unwrap();
+        receiver.recv_timeout(Duration::from_secs(5)).unwrap();
+        // Drop while both worker jobs still own the previous memo epoch.
+        drop(driver);
+        gate.release();
+        bowl.stir().await;
+        assert_eq!(bowl.scoop::<Query<&Counter>>().await.collect()[0].0, 1, "unrelated non-idempotent work must remain memoized");
+        assert!(bowl.scoop::<Query<&Answer>>().await.collect().iter().all(|a| a.0 == 2));
+
+        for &entity in &entities { bowl.entity(entity).insert((Request { gate: Arc::clone(&gate), value: 3 },)).await; }
+        gate.panic_once.store(true, Ordering::SeqCst);
+        assert!(std::panic::AssertUnwindSafe(bowl.stir()).catch_unwind().await.is_err());
+        bowl.stir().await;
+        assert_eq!(bowl.scoop::<Query<&Counter>>().await.collect()[0].0, 1);
+        assert!(bowl.scoop::<Query<&Answer>>().await.collect().iter().all(|a| a.0 == 3));
+    });
+}
