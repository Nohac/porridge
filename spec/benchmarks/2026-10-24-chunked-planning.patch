@@ -0,0 +1,69 @@
+//! Bounded read-only candidate jobs. Admission and publication stay on the driver.
+use super::*;
+
+pub(super) async fn prepare<P, Prepared>(
+    id: SystemId, snapshot: Arc<Snapshot>, memo: Arc<crate::planning::MemoMap>,
+    hint: Option<&[Entity]>, prepared: Prepared, buffers: &mut PlanningStorage, maximum: usize,
+) -> (Prepared, PlannedRun<P::State>)
+where P: SystemParam + 'static, Prepared: PreparedParam<P> + 'static,
+{
+    let states = match hint {
+        Some(hint) => P::states_hinted(&snapshot, hint),
+        None => P::states(&snapshot),
+    };
+    crate::metrics::add(crate::metrics::Counter::PlanCalls, 1);
+
+    #[cfg(feature = "parallel")]
+    if maximum > 0 && states.len() / maximum >= 2 && P::parallel_planning()
+        && let Ok(runtime) = tokio::runtime::Handle::try_current()
+        && runtime.metrics().num_workers() > 1
+    {
+        let workers = runtime.metrics().num_workers();
+        // Keep the requested grain: forcing multiple jobs per worker made
+        // tiny metadata chunks pay more dispatch/merge cost than useful work.
+        // The active-job limit still bounds concurrency to the existing pool.
+        let grain = maximum;
+        let count = states.len().div_ceil(grain);
+        let context = Arc::new((snapshot, memo, prepared));
+        let mut states = states.into_iter();
+        let mut jobs = tokio::task::JoinSet::new();
+        let mut next = 0;
+        let mut results: Vec<_> = (0..count).map(|_| None).collect();
+        while next < count || !jobs.is_empty() {
+            while next < count && jobs.len() < workers {
+                let chunk: Vec<_> = states.by_ref().take(grain).collect();
+                let mut scratch = buffers.workers.pop().unwrap_or_default();
+                let context = Arc::clone(&context);
+                let index = next;
+                next += 1;
+                jobs.spawn_on(async move {
+                    crate::metrics::add(crate::metrics::Counter::PlanningWorkerJobs, 1);
+                    crate::metrics::add(crate::metrics::Counter::PlanningWorkerRows, chunk.len() as u64);
+                    let planned = plan_states::<P>(id, &context.0, &context.1, chunk, &context.2, &mut scratch);
+                    // Drop epoch readers before the join result becomes visible.
+                    drop(context);
+                    (index, planned, scratch)
+                }, &runtime);
+            }
+            let (index, planned, scratch) = jobs.join_next().await.expect("pending planning job")
+                .expect("candidate preparation panicked or was cancelled");
+            results[index] = Some(planned);
+            buffers.workers.push(scratch);
+        }
+        let (_, _, prepared) = match Arc::try_unwrap(context) {
+            Ok(context) => context,
+            Err(_) => panic!("planning epoch still has readers after all jobs completed"),
+        };
+        let mut invocations = Vec::new();
+        for result in results {
+            invocations.extend(result.expect("planning chunk completed").invocations);
+        }
+        return (prepared, PlannedRun { completed: true, invocations });
+    }
+
+    let planned = plan_states::<P>(id, &snapshot, &memo, states, &prepared, &mut buffers.scratch);
+    (prepared, planned)
+}
