+pub(crate) type MemoMap = HashMap<SystemInvocation, MemoEntry>;
+
+/// Serial execution owns the table directly. Planning readers share it only
+/// while preparing candidates; the guard always retains an authoritative owner.
+pub(crate) enum Memo {
+    Owned(MemoMap),
+    Shared(Arc<MemoMap>),
+}
+
+impl Memo {
+    pub(crate) fn read(&self) -> &MemoMap {
+        match self { Self::Owned(map) => map, Self::Shared(map) => map }
+    }
+
+    pub(crate) fn share(&mut self) -> Arc<MemoMap> {
+        if let Self::Owned(_) = self {
+            let Self::Owned(map) = std::mem::replace(self, Self::Owned(HashMap::new())) else { unreachable!() };
+            *self = Self::Shared(Arc::new(map));
+        }
+        match self { Self::Shared(map) => Arc::clone(map), Self::Owned(_) => unreachable!() }
+    }
+
+    pub(crate) fn write(&mut self) -> &mut MemoMap {
+        match self {
+            Self::Owned(map) => map,
+            Self::Shared(map) => {
+                if Arc::strong_count(map) > 1 {
+                    let copy = (**map).clone();
+                    crate::metrics::add(crate::metrics::Counter::PlanningMemoCopies, 1);
+                    *map = Arc::new(copy);
+                }
+                Arc::get_mut(map).expect("driver owns memo after planning readers finish")
+            }
+        }
+    }
+
+    pub(crate) fn into_inner(self) -> MemoMap {
+        match self {
+            Self::Owned(map) => map,
+            Self::Shared(map) => {
+                // A cancelled driver can leave bounded read-only jobs running.
+                // Recover independent memo state rather than lending freed memory.
+                match Arc::try_unwrap(map) {
+                    Ok(map) => map,
+                    Err(shared) => {
+                        let copy = (*shared).clone();
+                        crate::metrics::add(crate::metrics::Counter::PlanningMemoCopies, 1);
+                        copy
+                    }
+                }
+            }
+        }
+    }
+}
