+#[test]
+fn snapshot_mutation_does_not_activate_live_consumers_but_live_store_writes_do() {
+    block_on(async {
+        let bowl = Bowl::builder().system(produce).build();
+        let id = bowl.insert((Input,)).await.entity();
+        bowl.stir().await;
+        let mut state = bowl.inner.state.lock().await;
+        let mut selected = vec![];
+        {
+            let State { activation, world, .. } = &mut *state;
+            activation.collect(&mut world.dirty_components, Phase::Evaluate, &mut selected);
+        }
+        assert!(selected.is_empty());
+        let mut snapshot = state.world.clone();
+        snapshot.insert_base(id, Input);
+        {
+            let State { activation, world, .. } = &mut *state;
+            activation.collect(&mut world.dirty_components, Phase::Evaluate, &mut selected);
+        }
+        assert!(selected.is_empty(), "snapshot clones must not share live dirty markers");
+        state.world.insert_base(id, Input);
+        {
+            let State { activation, world, .. } = &mut *state;
+            activation.collect(&mut world.dirty_components, Phase::Evaluate, &mut selected);
+        }
+        assert_eq!(selected, [0]);
+    });
+}
