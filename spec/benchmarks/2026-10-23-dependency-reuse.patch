+
+/// Empty owned buffers retired by memo replacement. Live invocation/memo data
+/// never remains in this free list, so checkout transfers exclusive ownership.
+#[derive(Default)]
+pub(crate) struct DependencyBuffers {
+    free: Vec<Vec<Dep>>,
+}
+
+impl DependencyBuffers {
+    pub(crate) fn copy_from(&mut self, observed: &[Dep]) -> Vec<Dep> {
+        if observed.is_empty() {
+            return Vec::new();
+        }
+        let mut buffer = self.free.pop().unwrap_or_default();
+        buffer.extend_from_slice(observed);
+        buffer
+    }
+
+    pub(crate) fn recycle(&mut self, mut retired: Vec<Dep>) {
+        if retired.capacity() != 0 {
+            retired.clear();
+            self.free.push(retired);
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn retained_buffers(&self) -> usize {
+        self.free.len()
+    }
+}
