#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Measure fixed-world allocator traffic and uninstrumented wall time separately."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import runpy
import statistics
import subprocess
import time



def iteration_totals(samples, allocations):
    """Keep the complete measured iteration as the primary accounting unit."""
    rounds = {sample["round"]: dict(sample, engine={}, kernel={}) for sample in samples}
    for value in allocations:
        row = rounds[value["round"]]
        row["engine"][value["operation"]] = value["engine"]
        row["kernel"][value["operation"]] = value["kernel"]
    for row in rounds.values():
        row["engine"]["allocation_events"] = row["engine"]["alloc_calls"] + row["engine"]["realloc_calls"]
    return list(rounds.values())


def check_budget(record, rules):
    if not record["counting"] or record["label"] != "after":
        return []
    key = (record["case"], record["workers"], record["slots"])
    matches = [rule for rule in rules if (rule["case"], rule["workers"], rule["slots"]) == key]
    if len(matches) != 1:
        return [f"expected one budget for {key}, found {len(matches)}"]
    failures = []
    for row in record["iterations"]:
        for metric, maximum in matches[0]["maximum_per_iteration"].items():
            value = row["engine"].get(metric)
            if value is None or value > maximum:
                failures.append(f"{key} round {row['round']}: {metric}={value}, budget={maximum}")
    return failures


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", type=Path, default=Path("target/release/examples/steady_allocations"))
    parser.add_argument("--before", type=Path, help="preserved baseline binary; alternate order each repetition")
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--cases", default="purchases,read,probe")
    parser.add_argument("--workers", default="1,8")
    parser.add_argument("--slots", default="1,1000")
    parser.add_argument("--budgets", type=Path, help="optional complete-iteration budget JSON; only checks the candidate")
    parser.add_argument("--metrics", action="store_true", help="engine diagnostics during allocation passes only")
    parser.add_argument("--rounds", type=int, default=10)
    parser.add_argument("--warmup", type=int, default=3)
    parser.add_argument("--repetitions", type=int, default=3)
    args = parser.parse_args()
    cases, workers, slots = args.cases.split(","), list(map(int, args.workers.split(","))), list(map(int, args.slots.split(",")))
    if set(cases) - {"purchases", "drive", "idle", "read", "probe"} or min(*workers, *slots, args.rounds, args.warmup, args.repetitions) <= 0:
        parser.error("unknown case or nonpositive size")
    if args.out.exists() and any(args.out.iterdir()):
        parser.error("output directory must be new or empty")
    budgets = json.loads(args.budgets.read_text())["rules"] if args.budgets else None
    failures = []
    args.out.mkdir(parents=True, exist_ok=True)
    root = args.out.resolve()
    allowed = sorted(os.sched_getaffinity(0))
    driver = allowed[0]
    cpu_order = runpy.run_path(str(Path(__file__).with_name("profile-engine")))["worker_order"](allowed, driver)
    if len(cpu_order) < max(workers):
        parser.error("not enough separate worker CPUs in current affinity")
    binaries = {"after": args.binary.resolve()}
    if args.before:
        binaries["before"] = args.before.resolve()
    report = dict(base_commit=subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip(),
        binaries={label: {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()} for label, path in binaries.items()},
        source_sha256={str(p): hashlib.sha256(p.read_bytes()).hexdigest() for directory in ["crates/bowl/src", "crates/benches/src", "crates/benches/examples"] for p in Path(directory).rglob("*.rs")},
        source_scope="current workspace; supplied baseline binary needs its original build manifest",
        runner_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        build_command="cargo build --workspace --all-targets --profile bench -j 20",
        features=subprocess.check_output(["cargo", "tree", "--workspace", "-e", "features", "-i", "tokio"], text=True),
        rustc=subprocess.check_output(["rustc", "--version"], text=True).strip(),
        kernel=list(os.uname()), driver_cpu=driver, worker_cpus=cpu_order,
        configuration=vars(args), records=[])
    for case in cases:
        for count in workers:
            for size in slots:
                for counting in [1, 0]:
                    for repeat in range(args.repetitions):
                        order = list(binaries)
                        if repeat % 2 == 0:
                            order.reverse()
                        for label in order:
                            name = f"{label}-{case}-{count}-{size}-count{counting}-{repeat}"
                            ready = root / f"{name}.ready"
                            settings = dict(ALLOC_CASE=case, ALLOC_WORKERS=str(count), ALLOC_SLOTS=str(size),
                                ALLOC_COUNT=str(counting), ALLOC_METRICS=str(int(args.metrics and counting)), ALLOC_ROUNDS=str(args.rounds), ALLOC_WARMUP=str(args.warmup), ALLOC_READY=str(ready))
                            with (root / f"{name}.tsv").open("w") as out, (root / f"{name}.err").open("w") as err:
                                proc = subprocess.Popen([str(binaries[label])], env=os.environ | settings, stdin=subprocess.PIPE, stdout=out, stderr=err, text=True)
                                try:
                                    deadline = time.monotonic() + 30
                                    while not ready.exists() or not ready.read_text().strip():
                                        if proc.poll() is not None or time.monotonic() > deadline:
                                            raise RuntimeError(f"startup failed: {name}")
                                        time.sleep(0.005)
                                    pid = int(ready.read_text())
                                    threads = sorted(p for p in Path(f"/proc/{pid}/task").iterdir() if p.name != str(pid))
                                    assert len(threads) == count, threads
                                    os.sched_setaffinity(pid, {driver})
                                    for thread, cpu in zip(threads, cpu_order):
                                        os.sched_setaffinity(int(thread.name), {cpu})
                                    proc.communicate("go\n", timeout=300)
                                    if proc.returncode:
                                        raise RuntimeError(f"measurement failed: {name}, inspect stderr")
                                finally:
                                    if proc.poll() is None:
                                        proc.kill()
                                        proc.wait()
                            samples, allocations, metrics = [], [], []
                            for line in (root / f"{name}.tsv").read_text().splitlines():
                                parts = line.split("\t")
                                if parts[0] == "sample":
                                    samples.append(dict(round=int(parts[1]), operations=int(parts[2]), wall_ns=int(parts[3])))
                                elif parts[0] == "metric":
                                    metrics.append(dict(round=int(parts[1]), name=parts[2], value=int(parts[3])))
                                elif parts[0] == "allocation":
                                    allocations.append(dict(round=int(parts[1]), operation=parts[2], engine=int(parts[3]), kernel=int(parts[4])))
                            assert len(samples) == args.rounds
                            record = dict(label=label, case=case, workers=count, slots=size, counting=bool(counting), repeat=repeat, samples=samples, allocations=allocations, metrics=metrics,
                                iterations=iteration_totals(samples, allocations))
                            report["records"].append(record)
                            if budgets is not None:
                                failures.extend(check_budget(record, budgets))
                            report["budget_failures"] = failures
                            (root / "report.json").write_text(json.dumps(report, indent=2, default=str) + "\n")
                for label in binaries:
                    records = [r for r in report["records"] if (r["label"], r["case"], r["workers"], r["slots"]) == (label, case, count, size)]
                    iterations = [row for r in records if r["counting"] for row in r["iterations"]]
                    calls = [row["engine"]["alloc_calls"] for row in iterations]
                    reallocs = [row["engine"]["realloc_calls"] for row in iterations]
                    events = [row["engine"]["allocation_events"] for row in iterations]
                    per_op = [row["engine"]["alloc_calls"] / row["operations"] for row in iterations]
                    times = [s["wall_ns"] / s["operations"] / 1000 for r in records if not r["counting"] for s in r["samples"]]
                    print(f"{label:6} {case:9} workers={count} slots={size}: "
                          f"median {statistics.median(calls):.1f} alloc + {statistics.median(reallocs):.1f} realloc/iteration "
                          f"(max {max(events)} events); {statistics.median(per_op):.3f} alloc/op; "
                          f"{statistics.median(times):.2f} us/op", flush=True)
    if failures:
        raise SystemExit("Allocation budgets exceeded:\n" + "\n".join(failures))
    if budgets is not None:
        print("Complete-iteration allocation budgets passed.", flush=True)


if __name__ == "__main__":
    main()
