#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Rank heap allocation/reallocation sites in warmed fixed-ID purchases."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import runpy
import re
import subprocess
import time



def allocation_origin(stack):
    """Group DHAT origins; reallocations stay attached to the original allocation."""
    stack = "\n".join(stack)
    if "bowl::system::plan_prepared" in stack:
        if ">::deps " in stack or ">::deps_into " in stack:
            return "planning: dependencies"
        if ">::access " in stack or ">::access_into " in stack or "bowl::query::filtered_access" in stack:
            return "planning: access"
        if ">::keys " in stack or ">::keys_into " in stack:
            return "planning: keys"
        if ">::fingerprint_candidates " in stack:
            return "planning: join candidates"
        return "planning: other"
    # Outside planning, assign the nearest recognized allocation-origin frame.
    # Prefix checks avoid matching types merely nested inside generic arguments.
    for raw in stack.splitlines():
        frame = re.sub(r"^0x[0-9a-f]+: ", "", raw)
        if frame.startswith("<bowl::commands::Commands<") and ">>::with_queue" in frame:
            return "command producer handles"
        if frame.startswith("bowl::system::finish_invocation"):
            return "outputs and memo updates"
        if frame.startswith("<bowl::query::guards::GuardStore>"):
            return "guard buffers"
        if frame.startswith("<bowl::commands::arena::CommandQueue>") and "::consume" in frame:
            return "command application/storage"
        if frame.startswith("bowl::bowl::commit_system_run"):
            return "publication"
        if frame.startswith("<bowl::system::FunctionSystem<"):
            return "row construction/execution"
        if frame.startswith(("<futures_util::stream::futures_unordered", "<futures_channel::mpsc", "<bowl::dispatch::")):
            return "dispatch and completion"
        if frame.startswith("<bowl::world::") and "::clone" in frame:
            return "structural cloning"
        if frame.startswith("<bowl::bowl::Bowl>::insert_inner"):
            return "input staging/storage"
    return "unclassified"


def origin_totals(sites, requests):
    totals = {}
    for site in sites:
        origin = allocation_origin(site["stack"])
        totals[origin] = totals.get(origin, 0) + site["calls"]
    total = sum(totals.values())
    return [
        dict(origin=origin, calls=calls, calls_per_request=calls / requests,
             percent=100 * calls / total)
        for origin, calls in sorted(totals.items(), key=lambda pair: pair[1], reverse=True)
    ]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", type=Path, default=Path("target/release/examples/profile_allocations"))
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--workers", default="1,8")
    parser.add_argument("--slots", type=int, default=1000)
    parser.add_argument("--rounds", type=int, default=1)
    parser.add_argument("--warmup", type=int, default=8)
    parser.add_argument("--lifetime", action="store_true", help="profile setup, warmup and per-round live heap; no timing or per-request attribution")
    parser.add_argument("--grow-to", type=int, help="grow the same Bowl to this population, then repeat warmup/steady rounds; requires --lifetime")
    args = parser.parse_args()
    workers = list(map(int, args.workers.split(",")))
    if args.grow_to is not None and (not args.lifetime or args.grow_to < args.slots):
        parser.error("--grow-to requires --lifetime and cannot shrink the population")
    grow_to = args.slots if args.grow_to is None else args.grow_to
    if min(*workers, args.slots, args.rounds, args.warmup) <= 0:
        parser.error("sizes must be positive")
    if args.out.exists() and any(args.out.iterdir()):
        parser.error("output directory must be new or empty")
    args.out.mkdir(parents=True, exist_ok=True)
    root, binary = args.out.resolve(), args.binary.resolve()
    allowed = sorted(os.sched_getaffinity(0))
    driver = allowed[0]
    cpus = runpy.run_path(str(Path(__file__).with_name("profile-engine")))["worker_order"](allowed, driver)
    if max(workers) > len(cpus):
        parser.error("not enough distinct worker CPUs")
    report = dict(base_commit=subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip(),
        binary_sha256=hashlib.sha256(binary.read_bytes()).hexdigest(), driver_cpu=driver, worker_cpus=cpus,
        source_sha256={str(p): hashlib.sha256(p.read_bytes()).hexdigest() for directory in ["crates/bowl/src", "crates/benches/src", "crates/benches/examples"] for p in Path(directory).rglob("*.rs")},
        counts_include_reallocations=True, reallocations_attributed_to_original_allocation=True,
        configuration=dict(workers=workers, slots=args.slots, rounds=args.rounds, warmup=args.warmup, lifetime=args.lifetime, grow_to=grow_to),
        runner_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(), records=[])
    for count in workers:
        directory = root / f"workers-{count}"
        directory.mkdir()
        profile, ready = directory / "heap.json", directory / "ready"
        env = os.environ | dict(HEAP_WORKERS=str(count), HEAP_SLOTS=str(args.slots), HEAP_ROUNDS=str(args.rounds), HEAP_WARMUP=str(args.warmup), HEAP_OUT=str(profile), HEAP_READY=str(ready), HEAP_LIFETIME=str(int(args.lifetime)), HEAP_GROW_TO=str(grow_to))
        with (directory / "stdout.log").open("w") as out, (directory / "stderr.log").open("w") as err:
            process = subprocess.Popen([str(binary)], env=env, stdout=out, stderr=err, stdin=subprocess.PIPE, text=True)
            try:
                deadline = time.monotonic() + 30
                while not ready.exists() or not ready.read_text().strip():
                    if process.poll() is not None or time.monotonic() > deadline:
                        raise RuntimeError(f"startup failed: {directory}")
                    time.sleep(0.005)
                pid = int(ready.read_text())
                threads = sorted(p for p in Path(f"/proc/{pid}/task").iterdir() if p.name != str(pid))
                assert len(threads) == count
                os.sched_setaffinity(pid, {driver})
                for thread, cpu in zip(threads, cpus):
                    os.sched_setaffinity(int(thread.name), {cpu})
                process.communicate("go\n", timeout=600)
                if process.returncode:
                    raise RuntimeError(f"profile failed; inspect {directory}")
            finally:
                if process.poll() is None:
                    process.kill()
                    process.wait()
        data = json.loads(profile.read_text())
        operations = None if args.lifetime else args.slots * args.rounds
        total = sum(point["tbk"] for point in data["pps"])
        sites = []
        for point in sorted(data["pps"], key=lambda point: point["tbk"], reverse=True):
            stack = [data["ftbl"][frame] for frame in point["fs"]]
            sites.append(dict(calls=point["tbk"], calls_per_request=None if operations is None else point["tbk"] / operations,
                percent=100 * point["tbk"] / total, requested_bytes=point["tb"], stack=stack))
        metrics = {}
        memory = []
        for line in (directory / "stdout.log").read_text().splitlines():
            if line.startswith("metric\t"):
                _, key, value = line.split("\t")
                metrics[key] = int(value)
            elif line.startswith("memory\t"):
                _, phase, iteration, slots, blocks, live, peak, events = line.split("\t")
                memory.append(dict(phase=phase, iteration=int(iteration), slots=int(slots),
                    live_blocks=int(blocks), live_bytes=int(live), peak_bytes=int(peak), allocation_events=int(events)))
        record = dict(workers=count, requests=operations, calls=total, calls_per_request=None if operations is None else total / operations,
            metrics=metrics, memory=memory, sites=sites, origins=[] if args.lifetime else origin_totals(sites, operations), profile_sha256=hashlib.sha256(profile.read_bytes()).hexdigest())
        report["records"].append(record)
        (root / "report.json").write_text(json.dumps(report, indent=2) + "\n")
        if args.lifetime:
            for phase in ["steady", "grown-steady"]:
                points = [point for point in memory if point["phase"] == phase]
                if points:
                    live = [point["live_bytes"] for point in points]
                    print(f"{count} workers, {phase}, {points[0]['slots']} slots: live {min(live)}..{max(live)} bytes; "
                          f"first→last {live[0]}→{live[-1]}; peak {points[-1]['peak_bytes']} bytes", flush=True)
            if not memory:
                raise RuntimeError("lifetime profiler returned no memory samples")
            continue
        print(f"{count} workers: {total / operations:.2f} allocation/reallocation calls per request", flush=True)
        print("storage diagnostics:", {k: v for k, v in metrics.items() if k.startswith(("command_", "planning_"))}, flush=True)
        for origin in record["origins"]:
            print(f"  {origin['percent']:5.1f}% {origin['calls_per_request']:7.2f}/request {origin['origin']}", flush=True)


if __name__ == "__main__":
    main()
